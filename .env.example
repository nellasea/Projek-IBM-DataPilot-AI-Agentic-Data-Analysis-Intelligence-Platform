# DataPilot AI capstone configuration
# Offline Rule-Based Agent mode. No external API credentials are required.
LLM_PROVIDER=fallback
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
SQLITE_URL=sqlite+aiosqlite:///./datapilot.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
